# Copy to .env and adjust as needed.
# No API keys required — all data sources are public.

# Cache directories (defaults to backend/.cache and backend/data/noaa)
# CACHE_DIR=.cache
# NOAA_DATA_DIR=data/noaa

# Region for NOAA GFS-Wave subsetting (Central America defaults)
# NOAA_REGION_LEFT_LON=-95.0
# NOAA_REGION_RIGHT_LON=-65.0
# NOAA_REGION_TOP_LAT=25.0
# NOAA_REGION_BOTTOM_LAT=5.0

# Open-Meteo wave model (non-GFS; icon_wave recommended)
# OPEN_METEO_WAVE_MODEL=icon_wave

# Cache TTLs in seconds
# GEOCODE_CACHE_TTL=86400
# FORECAST_CACHE_TTL=3600
# NOAA_REFRESH_INTERVAL=21600

# Durable private journal; mount this path on persistent storage.
# JOURNAL_DB_PATH=/var/lib/surf-forecast/journal.sqlite3
# MATCH_HEIGHT_M=0.5
# MATCH_PERIOD_S=2
# MATCH_WIND_MPS=2
# MATCH_DIRECTION_DEG=45
# MATCH_SEA_LEVEL_M=0.3
